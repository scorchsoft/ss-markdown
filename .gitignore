# Android (apps/android). Build artefacts never go in git; hand-over APKs
# go to Drive.
apps/android/.gradle/
apps/android/**/build/
apps/android/build-logic/.gradle/
apps/android/local.properties
apps/android/.kotlin/
apps/android/build-logic/.kotlin/
apps/android/keystore.properties
apps/android/**/*.hprof
.idea/
*.iml
.DS_Store

# Signing material never enters git.
*.keystore
*.jks
*.p12

*.apk
*.aab
*.aar

# The app's Baseline Profile is generated on CI's emulator (the `perf` job)
# and compiled into the hand-over APK there; it is ~6 MB of text that
# changes with every run, so it is not committed (apps/android/CLAUDE.md,
# "The hand-over build").
apps/android/app/src/main/generated/baselineProfiles/
