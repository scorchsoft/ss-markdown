# Read by ktlint (through the ssmarkdown.static-analysis convention) and by
# the IDE, so both format the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# ktlint's own style: the Kotlin coding conventions (docs/engineering.md)
# plus stricter, unambiguous rules for wrapping, so formatting is never a
# review topic.
ktlint_code_style = ktlint_official
max_line_length = 120
# Composables are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,toml}]
indent_size = 2
