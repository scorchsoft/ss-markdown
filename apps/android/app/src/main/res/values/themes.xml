<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose. Its background matches the page so a
         cold start never flashes a different colour before the first frame. -->
    <style name="Theme.SSMarkdown" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
