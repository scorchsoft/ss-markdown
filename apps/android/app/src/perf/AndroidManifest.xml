<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark build types only (benchmarkRelease, nonMinifiedRelease); see
     app/build.gradle.kts. Never in debug, release or the hand-over APK.

     Exported so the benchmark can reset a file from the shell
     (`content call`), but guarded by DUMP, which only the shell and the
     system hold: no app on the phone can read or write through it. The app
     itself needs no permission to read its own provider. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.scorchsoft.ssmarkdown.perf.PerfDocumentProvider"
            android:authorities="${applicationId}.perf"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
